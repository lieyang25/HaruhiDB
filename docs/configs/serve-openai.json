{
  "common": {
    "db_path": "/tmp/haruhidb-openai.db",
    "allow_write": false,
    "timeout": "20s"
  },
  "llm": {
    "backend": "openai",
    "model": "gpt-5-mini",
    "reasoning_effort": "off",
    "examples_path": "../docs/action-v1-showcase-example.md"
  },
  "serve": {
    "listen": ":8080",
    "max_body_bytes": 1048576,
    "rate_limit_per_minute": 120
  }
}
